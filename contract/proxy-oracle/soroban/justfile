set dotenv-load := false

# =============================================================================
# Templar Soroban Proxy Oracle — build, test, and release gates
# =============================================================================
# Run `just -f contract/proxy-oracle/soroban/justfile --list` for all recipes.
#
# Prerequisites:
#   - Rust with the wasm32v1-none target (rustup target add wasm32v1-none)
#   - Stellar CLI v25.2.0+ (cargo install --locked stellar-cli --features opt)
#   - Python 3 (release, validation, and rehearsal helpers)
#
# Size budgets: runtime & governance <= 131072 bytes (128 KiB); adapter, Lazer source, batcher <= 32768 (32 KiB).
# =============================================================================

root             := justfile_directory() + "/../../.."
release_dir      := root + "/target/proxy-oracle-soroban"
scripts_dir      := justfile_directory() + "/scripts"
evidence_dir     := release_dir + "/evidence"
manifest_path    := release_dir + "/release-manifest.json"
soroban_rust_toolchain := env_var_or_default("SOROBAN_RUST_TOOLCHAIN", "1.89.0")

# =============================================================================
# TEST
# =============================================================================

# `_test-fast` is the root `test-fast` without its compose-Postgres probe; no
# suite here touches a database.
test:
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-common -p templar-proxy-oracle-soroban-governance-common
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-contract --features testutils
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-governance-contract --features testutils
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-sep40-adapter-contract --features testutils
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-pyth-lazer-source-contract --features testutils
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-batcher-contract --features testutils

test-integration:
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-soroban-integration-tests

test-scripts:
    @python3 -m unittest discover -s "{{scripts_dir}}" -p "test_*.py"

# =============================================================================
# BUILD
# =============================================================================

_artifacts action slug:
    @python3 "{{scripts_dir}}/make_release_manifest.py" \
        --action "{{action}}" \
        --slug "{{slug}}" \
        --rust-toolchain "{{soroban_rust_toolchain}}"

# Developer builds invalidate release evidence and never write a manifest.
build slug="all":
    @just -f "{{justfile_directory()}}/justfile" _artifacts build "{{slug}}"

build-runtime:
    @just -f "{{justfile_directory()}}/justfile" build runtime

build-governance:
    @just -f "{{justfile_directory()}}/justfile" build governance

build-sep40-adapter:
    @just -f "{{justfile_directory()}}/justfile" build sep40_adapter

build-lazer-source:
    @just -f "{{justfile_directory()}}/justfile" build lazer_source

build-batcher:
    @just -f "{{justfile_directory()}}/justfile" build batcher

optimize slug="all":
    @just -f "{{justfile_directory()}}/justfile" _artifacts optimize "{{slug}}"

optimize-runtime:
    @just -f "{{justfile_directory()}}/justfile" optimize runtime

optimize-governance:
    @just -f "{{justfile_directory()}}/justfile" optimize governance

optimize-sep40-adapter:
    @just -f "{{justfile_directory()}}/justfile" optimize sep40_adapter

optimize-lazer-source:
    @just -f "{{justfile_directory()}}/justfile" optimize lazer_source

optimize-batcher:
    @just -f "{{justfile_directory()}}/justfile" optimize batcher

# =============================================================================
# SIZE GATE
# =============================================================================

# Developer five-Wasm build, ABI, and size gate. No release claim.
size-check:
    @just -f "{{justfile_directory()}}/justfile" _artifacts size-check all


# =============================================================================
# COMBINED RELEASE GATE
# =============================================================================

# Tests, one complete clean-source release build, then validation without rebuilding.
# Run deterministic budget scenarios (soroban-sdk testutils, not live simulation).
budget-check:
    @mkdir -p "{{evidence_dir}}"
    @python3 "{{scripts_dir}}/budget_report.py" \
        --root "{{root}}" \
        --out "{{evidence_dir}}/budget-check.txt"
    @echo "✓ Budget check passed — evidence: {{evidence_dir}}/budget-check.txt"

# Offline artifact/manifest consistency check plus the recorded deploy commands.
dry-run:
    @if [ ! -f "{{manifest_path}}" ]; then \
        echo "ERROR: release manifest not found — run: just -f {{justfile_directory()}}/justfile release" >&2; \
        exit 1; \
    fi
    @mkdir -p "{{evidence_dir}}"
    @python3 "{{scripts_dir}}/dry_run_deploy.py" \
        --manifest "{{manifest_path}}" \
        --root "{{root}}" \
        --out "{{evidence_dir}}/dry-run.txt"
    @echo "✓ Dry-run passed — evidence: {{evidence_dir}}/dry-run.txt"

release-gate: test test-integration test-scripts budget-check release validate-release dry-run
    @echo "✓ Proxy-oracle Soroban release gate complete"

# Clean-source, manifest-last publication of all five optimized Wasms.
release:
    @just -f "{{justfile_directory()}}/justfile" _artifacts release all
    @echo "✓ Release manifest: {{release_dir}}/release-manifest.json"

# Validate the canonical schema-4 manifest and exact five canonical artifacts.
validate-release:
    @python3 "{{scripts_dir}}/validate_release_artifacts.py"

# =============================================================================
# AUDIT READINESS GATE
# =============================================================================

# Full pre-audit gate (reproducible from a clean checkout).
audit-ready: release-gate
    @echo "=== Soroban Proxy Oracle audit-ready gate ==="
    @if grep -nE "TBD|TODO|DECISION NEEDED|FIXME" "{{justfile_directory()}}/AUDIT.md"; then \
        echo "ERROR: unresolved placeholders in AUDIT.md" >&2; \
        exit 1; \
    fi
    @just --justfile "{{root}}/justfile" _test-fast -p templar-proxy-oracle-kernel --features serde,borsh --lib
    @cd "{{root}}" && cargo fmt --check
    @cd "{{root}}" && cargo clippy --all-features --workspace --tests -- -D warnings
    @cd "{{root}}" && git diff --check
    @echo "✓ audit-ready gate passed"

# =============================================================================
# UTILITIES
# =============================================================================

catalog:
    @python3 "{{scripts_dir}}/release_artifacts.py"

runtime-wasm-path:
    @python3 "{{scripts_dir}}/release_artifacts.py" --wasm-path runtime

governance-wasm-path:
    @python3 "{{scripts_dir}}/release_artifacts.py" --wasm-path governance

sizes:
    @python3 "{{scripts_dir}}/release_artifacts.py" --sizes
